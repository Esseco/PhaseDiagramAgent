{
  "config_session_path": "../local/config_session.json",
  "editable_config_draft_path": "search_config.project.json",
  "state_path": "../local/current/state.json",
  "ledger_path": "../local/current/phase_data.json",
  "phase_references_path": "../local/phase_references.json",
  "new_runs_directory": "../local/open_webui_runs",
  "phase_diagram_directory": "../local/current/phase_diagrams",
  "approval_directory": "../local/current/approvals",
  "local_action_directory": "../local/current/approved_batches",
  "deepseek": {
    "model": "deepseek-flash",
    "base_url": "https://api.deepseek.com",
    "max_tokens": 800,
    "timeout": 60,
    "configuration_thinking": "disabled",
    "thinking": "enabled"
  },
  "manual_upload": {
    "enabled": false,
    "submit": false,
    "batches_directory": "../local/upload_batches",
    "worker_command": [
      "python3",
      "-m",
      "phase_agent.tools.remote.worker_cli",
      "--executor",
      "YOUR_PACKAGE:YOUR_TASK_EXECUTOR"
    ],
    "stage_batch_sizes": {
      "relax_and_feature": 100,
      "deep_search": 10,
      "dft_single_point": 1,
      "dft_relax": 1
    },
    "stage_profiles": {}
  },
  "runtime_adapters": {}
}
